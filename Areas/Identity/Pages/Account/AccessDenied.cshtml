@page
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]
@{
    // Shown when a signed-in user opens a page for another role (e.g. a customer opening /AdminPanel).
    // Overrides the default Identity "Access denied" page so it matches the Artie's design.
    ViewData["Title"] = "Access Denied";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Access Denied - Artie's</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-green: #1E3F20;
            --accent-gold: #D4A373;
            --bg-cream: #F9F6F0;
            --text-dark: #2C3E50;
        }
        body { font-family: 'Inter', sans-serif; margin: 0; }
        .auth-wrapper {
            min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;
            background: linear-gradient(135deg, rgba(30, 63, 32, 0.9), rgba(0, 0, 0, 0.7)),
                        url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=2070&auto=format&fit=crop') no-repeat center center fixed;
            background-size: cover;
        }
        .denied-card {
            background: #fff; border-radius: 24px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            max-width: 460px; width: 100%; padding: 48px 40px; text-align: center;
        }
        .denied-icon {
            width: 76px; height: 76px; border-radius: 50%; margin: 0 auto 20px;
            display: flex; align-items: center; justify-content: center;
            background: var(--bg-cream); color: var(--accent-gold); font-size: 2rem; border: 2px solid var(--accent-gold);
        }
        h1 { font-family: 'Playfair Display', serif; color: var(--primary-green); font-size: 2rem; }
        .btn-action { background: var(--primary-green); color: #fff; border-radius: 10px; padding: 12px; font-weight: 600; border: none; }
        .btn-action:hover { background: #142c16; color: #fff; }
        .btn-outline-gold { border: 1.5px solid var(--accent-gold); color: var(--primary-green); border-radius: 10px; padding: 11px; font-weight: 600; }
        .btn-outline-gold:hover { background: var(--accent-gold); color: #fff; }
    </style>
</head>
<body>
    <div class="auth-wrapper">
        <div class="denied-card">
            <div class="denied-icon"><i class="fa-solid fa-lock"></i></div>
            <h1>Access Denied</h1>
            <p class="text-muted mb-4">Fuhgeddaboudit, this room is for family only. Your account doesn't have access to that page.</p>

            <div class="d-grid gap-2">
                <a href="/" class="btn btn-action"><i class="fa-solid fa-house me-1"></i> Go to my dashboard</a>
                <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-grid">
                    <button type="submit" class="btn btn-outline-gold"><i class="fa-solid fa-right-from-bracket me-1"></i> Log out and switch account</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
