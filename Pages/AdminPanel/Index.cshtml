@page
@model WebApplication2.Pages.AdminPanel.IndexModel
@using WebApplication2.Pages.AdminPanel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
    var d = Model.Data;
    var maxQty = d.TopItems.Any() ? d.TopItems.Max(t => t.Quantity) : 1;
    var barColours = new[] { "var(--primary-green)", "var(--accent-gold)", "#6c757d", "#6c757d" };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Artie's Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <!-- Chart.js for Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Page Header */
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 40px 0 24px; }

        /* Stat Cards */
        .stat-card { background: #fff; border-radius: 16px; padding: 25px; border: 1px solid var(--line); box-shadow: 0 4px 12px rgba(0,0,0,.02); display: flex; align-items: center; gap: 20px; transition: transform 0.2s; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,.05); }
        .stat-icon { width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; }
        .icon-green { background: rgba(30, 63, 32, 0.1); color: var(--primary-green); }
        .icon-gold { background: rgba(212, 163, 115, 0.15); color: var(--gold-dark); }
        .icon-blue { background: rgba(13, 202, 240, 0.1); color: #0dcaf0; }
        .icon-danger { background: rgba(220, 53, 69, 0.1); color: #dc3545; }
        
        .stat-info h6 { color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 5px; font-weight: 600; }
        .stat-info h3 { font-weight: 700; margin: 0; color: var(--text-dark); }

        /* Dashboard Cards */
        .dash-card { background: #fff; border-radius: 16px; border: 1px solid var(--line); box-shadow: 0 4px 12px rgba(0,0,0,.02); height: 100%; }
        .dash-card-header { padding: 20px 25px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; }
        .dash-card-header h5 { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); margin: 0; }
        .dash-card-body { padding: 25px; }

        /* Activity Feed */
        .activity-list { list-style: none; padding: 0; margin: 0; }
        .activity-item { display: flex; gap: 15px; padding: 15px 0; border-bottom: 1px solid #f8f9fa; }
        .activity-item:last-child { border-bottom: none; padding-bottom: 0; }
        .activity-icon { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 0.9rem; }
        .activity-content p { margin: 0; font-size: 0.9rem; font-weight: 500; }
        .activity-content small { color: var(--muted); font-size: 0.8rem; }

        /* Quick Links Grid */
        .quick-link { display: flex; align-items: center; gap: 15px; padding: 15px; border-radius: 12px; border: 1px solid var(--line); text-decoration: none; color: var(--text-dark); transition: 0.2s; margin-bottom: 10px; }
        .quick-link:hover { background: var(--bg-cream); border-color: var(--accent-gold); color: var(--text-dark); }
        .quick-link i { width: 30px; text-align: center; font-size: 1.2rem; color: var(--primary-green); }
        .quick-link h6 { margin: 0; font-weight: 600; }
        .quick-link small { color: var(--muted); }
        
        .btn-gold { background: var(--accent-gold); color: var(--primary-green); font-weight: 700; border: 0; border-radius: 8px; padding: 6px 15px; transition: background .2s; font-size: 0.85rem; }
        .btn-gold:hover { background: var(--gold-dark); color: #fff; }

        .progress-bar {
            transition: width 1.5s cubic-bezier(0.22, 1, 0.36, 1);
            width: 0;
        }
        .empty-note { color: var(--muted); font-size: .9rem; }
    </style>
</head>
<body>

    <!-- Admin Navbar (Changed to standard container) -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-page="/AdminPanel/Index"><i class="fa-solid fa-utensils me-2"></i>Artie's Admin</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link active fw-bold" asp-page="/AdminPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageRestaurant">Restaurant</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageMenu">Menu</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Users">Users</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Reservations">Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/MonitorOrders">Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reviews">Reviews</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reports">Reports</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My Profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container (Changed to standard container) -->
    <div class="container pb-5">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-end flex-wrap">
            <div>
                <h1 class="page-title">Welcome Back, @Model.AdminName</h1>
                <p class="text-muted mb-4">Here is what is happening at the restaurant today.</p>
            </div>
            <div class="mb-4">
                <span class="text-muted small fw-bold"><i class="fa-regular fa-calendar me-1"></i> @DateTime.Today.ToString("dddd, MMM d, yyyy")</span>
            </div>
        </div>

        <!-- Top Stats Row -->
        <div class="row g-4 mb-4">
            <div class="col-md-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon icon-green"><i class="fa-solid fa-money-bill-wave"></i></div>
                    <div class="stat-info">
                        <h6>Today's Revenue</h6>
                        <h3>RM @d.TodayRevenue.ToString("N2")</h3>
                        @if (Model.ChangeVsYesterday is double change)
                        {
                            <small class="@(change >= 0 ? "text-success" : "text-danger") fw-bold">
                                <i class="fa-solid @(change >= 0 ? "fa-arrow-up" : "fa-arrow-down") me-1"></i> @Math.Abs(change).ToString("0")% vs yesterday
                            </small>
                        }
                        else
                        {
                            <small class="text-muted fw-bold">No sales yesterday</small>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon icon-gold"><i class="fa-solid fa-bag-shopping"></i></div>
                    <div class="stat-info">
                        <h6>Active Orders</h6>
                        <h3>@d.ActiveOrders</h3>
                        <small class="text-warning fw-bold">@d.PreparingOrders Preparing</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon icon-blue"><i class="fa-solid fa-calendar-check"></i></div>
                    <div class="stat-info">
                        <h6>Today's Bookings</h6>
                        <h3>@d.TodayBookings</h3>
                        <small class="text-muted fw-bold">@d.TodayGuests @(d.TodayGuests == 1 ? "guest" : "guests") expected</small>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-xl-3">
                <div class="stat-card">
                    <div class="stat-icon icon-danger"><i class="fa-solid fa-hourglass-half"></i></div>
                    <div class="stat-info">
                        <h6>Pending Bookings</h6>
                        <h3>@d.PendingReservations</h3>
                        <small class="text-danger fw-bold">
                            @if (d.ReviewCount > 0)
                            {
                                <span class="text-danger fw-bold"><i class="fa-solid fa-star me-1"></i>@d.AverageRating.ToString("0.0") avg rating</span>
                            }
                            else
                            {
                                <text>Awaiting confirmation</text>
                            }
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Middle Row: Chart & Quick Actions -->
        <div class="row g-4 mb-4">
            <div class="col-lg-8">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h5><i class="fa-solid fa-chart-line me-2"></i>Revenue Overview</h5>
                        <select class="form-select form-select-sm w-auto border-0 bg-light fw-bold" id="chartFilter" onchange="changeChartData()" aria-label="Chart period">
                            <option value="7days" selected>Last 7 Days</option>
                            <option value="30days">Last 30 Days</option>
                            <option value="year">This Year</option>
                        </select>
                    </div>
                    <div class="dash-card-body">
                        <canvas id="salesChart" height="80"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h5>Quick Management</h5>
                    </div>
                    <div class="dash-card-body">
                        <a asp-page="/AdminPanel/ManageRestaurant" class="quick-link">
                            <i class="fa-solid fa-store"></i>
                            <div><h6>Manage Restaurant</h6><small>Tables, Areas &amp; Hours</small></div>
                            <i class="fa-solid fa-chevron-right ms-auto text-muted small"></i>
                        </a>
                        <a asp-page="/AdminPanel/ManageMenu" class="quick-link">
                            <i class="fa-solid fa-book-open"></i>
                            <div><h6>Manage Menu</h6><small>Items, Prices &amp; Availability</small></div>
                            <i class="fa-solid fa-chevron-right ms-auto text-muted small"></i>
                        </a>
                        <a asp-page="/AdminPanel/Users" class="quick-link">
                            <i class="fa-solid fa-user-gear"></i>
                            <div><h6>Manage Users</h6><small>Staff &amp; Customer Accounts</small></div>
                            <i class="fa-solid fa-chevron-right ms-auto text-muted small"></i>
                        </a>
                        <a asp-page="/AdminPanel/Reports" class="quick-link mb-0">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            <div><h6>Generate Reports</h6><small>Sales &amp; Popular Items</small></div>
                            <i class="fa-solid fa-chevron-right ms-auto text-muted small"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Row: Recent Activity & Top Selling -->
        <div class="row g-4">
            <div class="col-lg-7">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h5>Recent Activity</h5>
                        <a asp-page="/AdminPanel/MonitorOrders" class="btn btn-gold btn-sm">View All</a>
                    </div>
                    <div class="dash-card-body pt-0">
                        @if (!d.Activity.Any())
                        {
                            <p class="empty-note mt-3 mb-0">No activity yet.</p>
                        }
                        <ul class="activity-list">
                            @foreach (var a in d.Activity)
                            {
                                <li class="activity-item">
                                    <div class="activity-icon @a.Css"><i class="fa-solid @a.Icon"></i></div>
                                    <div class="activity-content">
                                        <p>@a.Text</p>
                                        <small>@IndexModel.Ago(a.When) &bull; @a.Meta</small>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="dash-card">
                    <div class="dash-card-header">
                        <h5>Top Selling Items</h5>
                        <a asp-page="/AdminPanel/Reports" asp-route-type="Popular" asp-route-range="Month" class="text-decoration-none small fw-bold" style="color: var(--primary-green);">View Report</a>
                    </div>
                    <div class="dash-card-body">
                        @if (!d.TopItems.Any())
                        {
                            <p class="empty-note mb-0">No items sold in the last 30 days.</p>
                        }
                        @for (int i = 0; i < d.TopItems.Count; i++)
                        {
                            var t = d.TopItems[i];
                            <div class="d-flex align-items-center @(i < d.TopItems.Count - 1 ? "mb-3" : "")">
                                @if (!string.IsNullOrEmpty(t.ImageUrl))
                                {
                                    <img src="@t.ImageUrl" alt="" class="rounded me-3" style="width: 45px; height: 45px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="rounded me-3 d-flex align-items-center justify-content-center icon-green" style="width: 45px; height: 45px;"><i class="fa-solid fa-utensils"></i></div>
                                }
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between">
                                        <h6 class="mb-0 fw-bold small">@t.Name</h6>
                                        <span class="fw-bold small">@t.Quantity sold</span>
                                    </div>
                                    <div class="progress mt-1" style="height: 5px;">
                                        <div class="progress-bar" role="progressbar" data-width="@(t.Quantity * 100 / maxQty)%" style="background-color: @(barColours[i]);"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        let salesChartInstance = null;

        // Real figures from ReportService for each filter option
        const chartData = @Html.Raw(Model.ChartJson);

        function renderChart(filterValue) {
            const ctx = document.getElementById('salesChart').getContext('2d');
            if (salesChartInstance) salesChartInstance.destroy();

            const gradient = ctx.createLinearGradient(0, 0, 0, 400);
            gradient.addColorStop(0, 'rgba(30, 63, 32, 0.2)');
            gradient.addColorStop(1, 'rgba(30, 63, 32, 0)');

            const selected = chartData[filterValue];
            salesChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: selected.labels,
                    datasets: [{
                        label: 'Revenue (RM)',
                        data: selected.data,
                        borderColor: '#1E3F20',
                        backgroundColor: gradient,
                        borderWidth: 3,
                        pointBackgroundColor: '#D4A373',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: filterValue === '30days' ? 3 : 5,
                        pointHoverRadius: 7,
                        fill: true,
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: c => 'Revenue: RM ' + c.parsed.y.toLocaleString(undefined, { minimumFractionDigits: 2 }) } }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { borderDash: [5, 5], color: '#e8e3d9' },
                            ticks: { color: '#6b7a72', callback: v => 'RM ' + v.toLocaleString() }
                        },
                        x: { grid: { display: false }, ticks: { color: '#6b7a72' } }
                    }
                }
            });
        }

        function changeChartData() {
            renderChart(document.getElementById('chartFilter').value);
        }

        document.addEventListener('DOMContentLoaded', () => {
            Chart.defaults.font.family = "'Inter', sans-serif";
            renderChart('7days');

            // Animate the top-selling bars from left to right
            setTimeout(() => {
                document.querySelectorAll('.progress-bar').forEach((bar, i) => {
                    setTimeout(() => { bar.style.width = bar.dataset.width; }, i * 150);
                });
            }, 300);
        });
    </script>
</body>
</html>