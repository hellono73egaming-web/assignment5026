@page
@model WebApplication2.Pages.AdminPanel.MonitorOrdersModel
@using WebApplication2.Models
@using WebApplication2.Services
@using WebApplication2.Pages.AdminPanel
@{
    ViewData["Title"] = "Live Operations";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Operations - Artie's Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Page Header */
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 40px 0 24px; }

        /* Tabs */
        .nav-tabs { border-bottom: 2px solid var(--line); margin-bottom: 24px; }
        .nav-tabs .nav-link { border: none; color: var(--muted); font-weight: 600; font-size: 1.05rem; padding: 12px 20px; transition: color .2s; }
        .nav-tabs .nav-link:hover { color: var(--primary-green); }
        .nav-tabs .nav-link.active { color: var(--primary-green); border-bottom: 3px solid var(--accent-gold); background: transparent; }

        /* Cards */
        .content-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px; box-shadow: 0 4px 12px rgba(0,0,0,.02); }
        
        /* Tables */
        .table { margin-bottom: 0; }
        .table th { color: var(--muted); font-weight: 600; font-size: .85rem; text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid var(--line); padding: 16px; }
        .table td { padding: 16px; vertical-align: middle; border-bottom: 1px solid var(--line); }

        /* Status Badges */
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: .75rem; font-weight: 600; text-transform: uppercase; display: inline-block;}
        .badge-pending { background: #fdf0d5; color: #8a5a0b; }
        .badge-preparing { background: #def3f8; color: #0b6679; }
        .badge-ready { background: #e3f3e7; color: #1d6b34; }
        .badge-served { background: #e8ebe8; color: #1E3F20; }
        .badge-completed { background: #e8ebe8; color: #1E3F20; }
        .badge-cancelled { background: #fbeceb; color: #a02e24; }
        
        /* Payment Badges */
        .badge-paid { background: #e3f3e7; color: #1d6b34; }
        .badge-unpaid { background: #fbeceb; color: #a02e24; }

        /* Search Input */
        .search-input { border-radius: 10px 0 0 10px; border-right: none; }
        .search-icon { border-radius: 0 10px 10px 0; background: #fff; border-left: none; }
    </style>
</head>
<body>

    <!-- Admin Navbar (Changed to standard container) -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-page="/AdminPanel/Index"><i class="fa-solid fa-utensils me-2"></i>Artie's Admin</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageRestaurant">Restaurant</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageMenu">Menu</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Users">Users</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Reservations">Reservations</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" asp-page="/AdminPanel/MonitorOrders">Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reviews">Reviews</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reports">Reports</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My Profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Container (Changed to standard container) -->
    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <h1 class="page-title">Live Operations Monitor</h1>
            <p class="text-muted small mb-4">
                <strong>@Model.ActiveCount</strong> active @(Model.ActiveCount == 1 ? "order" : "orders") &middot;
                <strong>RM @Model.PaidToday.ToString("N2")</strong> collected today &middot; refreshes every 60s
            </p>
        </div>

        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" id="monitorTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="orders-tab" data-bs-toggle="tab" data-bs-target="#orders" type="button" role="tab" aria-selected="true">Customer Orders</button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="payments-tab" data-bs-toggle="tab" data-bs-target="#payments" type="button" role="tab" aria-selected="false">Payment Transactions</button>
            </li>
        </ul>

        <div class="tab-content" id="monitorTabsContent">

            <!-- ================= ORDERS TAB ================= -->
            <div class="tab-pane fade show active" id="orders" role="tabpanel">
                <div class="content-card">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <h5 class="fw-bold mb-0">Recent Orders <span class="text-muted fw-normal small">(latest 100)</span></h5>
                        <div class="input-group w-auto">
                            <input type="text" class="form-control search-input" placeholder="Search Order # or Customer..." onkeyup="searchTable(this, 'ordersTable')" aria-label="Search orders">
                            <span class="input-group-text search-icon"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table" id="ordersTable">
                            <thead>
                                <tr>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Type / Table</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                    <th>Status</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Orders.Any())
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-4">No orders yet.</td></tr>
                                }
                                @foreach (var o in Model.Orders)
                                {
                                    <tr>
                                        <td class="fw-bold">#@o.OrderNumber</td>
                                        <td>
                                            <div class="fw-semibold">@o.Customer?.FullName</div>
                                            <div class="text-muted small">@(o.Customer?.PhoneNumber ?? o.Customer?.Email)</div>
                                        </td>
                                        <td class="small">@(o.OrderType == OrderType.Takeaway ? "Takeaway" : "Dine-in")@(o.Reservation?.RestaurantTable != null ? " · " + o.Reservation.RestaurantTable.TableNumber : "")</td>
                                        <td class="text-muted small">@string.Join(", ", o.OrderItems.Select(i => $"{i.Quantity}x {i.MenuItem?.Name}"))</td>
                                        <td class="fw-bold">RM @o.Total.ToString("N2")</td>
                                        <td><span class="status-badge @MonitorOrdersModel.StatusCss(o.Status)">@OrderService.FriendlyStatus(o.Status)</span></td>
                                        <td class="text-muted small">@MonitorOrdersModel.Ago(o.CreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ================= PAYMENTS TAB ================= -->
            <div class="tab-pane fade" id="payments" role="tabpanel">
                <div class="content-card">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <h5 class="fw-bold mb-0">Transaction History <span class="text-muted fw-normal small">(latest 100)</span></h5>
                        <div class="input-group w-auto">
                            <input type="text" class="form-control search-input" placeholder="Search Ref # or Customer..." onkeyup="searchTable(this, 'paymentsTable')" aria-label="Search payments">
                            <span class="input-group-text search-icon"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                        </div>
                    </div>
                    <div class="table-responsive">
                        <table class="table" id="paymentsTable">
                            <thead>
                                <tr>
                                    <th>Transaction Ref</th>
                                    <th>Order #</th>
                                    <th>Customer</th>
                                    <th>Method</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Date/Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!Model.Payments.Any())
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-4">No payments yet.</td></tr>
                                }
                                @foreach (var p in Model.Payments)
                                {
                                    <tr>
                                        <td class="fw-bold font-monospace">@(p.ReceiptNumber ?? p.TransactionReference ?? "-")</td>
                                        <td>#@p.Order?.OrderNumber</td>
                                        <td>@p.Order?.Customer?.FullName</td>
                                        <td><i class="@MonitorOrdersModel.MethodIcon(p.Method) me-1 text-muted"></i> @MonitorOrdersModel.Method(p.Method)</td>
                                        <td class="fw-bold">RM @p.Amount.ToString("N2")</td>
                                        <td><span class="status-badge @MonitorOrdersModel.PaymentCss(p.Status)">@MonitorOrdersModel.PaymentLabel(p.Status)</span></td>
                                        <td class="text-muted small">@((p.PaidAt ?? p.CreatedAt).ToString("dd MMM, h:mm tt"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Search either table by any text in the row
        function searchTable(input, tableId) {
            const filter = input.value.toLowerCase();
            document.querySelectorAll('#' + tableId + ' tbody tr').forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        }

        // Remember the open tab across the auto-refresh
        const savedTab = sessionStorage.getItem('monitorTab');
        if (savedTab) {
            const btn = document.querySelector(`[data-bs-target="${savedTab}"]`);
            if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
        }
        document.querySelectorAll('#monitorTabs button').forEach(b =>
            b.addEventListener('shown.bs.tab', e => sessionStorage.setItem('monitorTab', e.target.dataset.bsTarget)));

        // Live: reload every 60s unless the admin is searching
        setInterval(() => {
            if (![...document.querySelectorAll('.search-input')].some(i => i.value)) location.reload();
        }, 60000);
    </script>
</body>
</html>