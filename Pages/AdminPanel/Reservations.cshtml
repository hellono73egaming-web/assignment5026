@page
@model WebApplication2.Pages.AdminPanel.ReservationsModel
@using WebApplication2.Models
@{
    ViewData["Title"] = "Reservations Overview";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reservations - Artie's Admin</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Page Header */
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 40px 0 10px; }

        /* Stat Cards */
        .stat-card { background: #fff; border-radius: 16px; padding: 20px; border: 1px solid var(--line); box-shadow: 0 4px 12px rgba(0,0,0,.02); text-align: center; }
        .stat-card h6 { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 600; margin-bottom: 5px; }
        .stat-card h3 { font-weight: 700; color: var(--primary-green); margin: 0; }

        /* Filter Bar */
        .filter-bar { background: #fff; border-radius: 12px; padding: 20px; box-shadow: 0 4px 12px rgba(0,0,0,.02); border: 1px solid var(--line); margin: 30px 0 20px; }
        .form-control, .form-select { border-radius: 8px; border-color: var(--line); }
        .form-control:focus, .form-select:focus { border-color: var(--accent-gold); box-shadow: 0 0 0 0.25rem rgba(212,163,115,.25); }

        /* Table Card */
        .content-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 24px; box-shadow: 0 4px 12px rgba(0,0,0,.02); }
        .table th { color: var(--muted); font-weight: 600; font-size: .8rem; text-transform: uppercase; letter-spacing: .05em; border-bottom: 2px solid var(--line); padding: 12px 16px; white-space: nowrap; }
        .table td { padding: 12px 16px; vertical-align: middle; border-bottom: 1px solid var(--line); font-size: 0.9rem; }
        
        /* Status Badge */
        .status-badge { padding: 6px 12px; border-radius: 20px; font-size: .75rem; font-weight: 600; text-transform: uppercase; display: inline-block; }
        .badge-pending { background: #fdf0d5; color: #8a5a0b; }
        .badge-confirmed { background: #e3f3e7; color: #1d6b34; }
        .badge-seated { background: #def3f8; color: #0b6679; }
        .badge-completed { background: #e8ebe8; color: #1E3F20; }
        .badge-cancelled { background: #fbeceb; color: #a02e24; }
        .badge-noshow { background: #eceeef; color: #565d63; }

        /* Buttons */
        .btn-gold { background: var(--accent-gold); color: var(--primary-green); font-weight: 700; border: 0; border-radius: 8px; padding: 10px 20px; transition: background .2s; }
        .btn-gold:hover { background: var(--gold-dark); color: #fff; }
        .btn-outline-green { border: 1.5px solid var(--primary-green); color: var(--primary-green); font-weight: 600; border-radius: 8px; }
        .btn-outline-green:hover { background: var(--primary-green); color: #fff; }
    </style>
</head>
<body>

    <!-- Admin Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-page="/AdminPanel/Index"><i class="fa-solid fa-utensils me-2"></i>Artie's Admin</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageRestaurant">Restaurant</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/ManageMenu">Menu</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Users">Users</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" asp-page="/AdminPanel/Reservations">Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/MonitorOrders">Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reviews">Reviews</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Promotions">Promos</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/AdminPanel/Reports">Reports</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My Profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap">
            <div>
                <h1 class="page-title">Reservation Overview</h1>
                <p class="text-muted mb-0">Monitor all past, current, and upcoming table bookings.</p>
            </div>
        </div>

        <!-- Quick Stats (live counts for the current search/date filter) -->
        <div class="row g-3 mt-1">
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <h6>Total Bookings</h6>
                    <h3>@Model.TotalReservations</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <h6>Confirmed</h6>
                    <h3 class="text-success">@Model.ConfirmedReservations</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <h6>Pending</h6>
                    <h3 class="text-warning">@Model.PendingReservations</h3>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="stat-card">
                    <h6>Cancelled</h6>
                    <h3 class="text-danger">@Model.CancelledReservations</h3>
                </div>
            </div>
        </div>

        <!-- Filter Bar -->
        <form method="get" class="filter-bar">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold small" for="searchInput">Search Customer</label>
                    <input type="text" class="form-control" id="searchInput" name="search" value="@Model.SearchTerm" placeholder="Name, email or phone...">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small" for="dateInput">Filter by Date</label>
                    <input type="date" class="form-control" id="dateInput" name="date" value="@Model.FilterDate?.ToString("yyyy-MM-dd")">
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold small" for="statusSelect">Filter by Status</label>
                    <select class="form-select" id="statusSelect" name="status">
                        <option value="">All Statuses</option>
                        <option value="Pending" selected="@(Model.FilterStatus == "Pending")">Pending</option>
                        <option value="Confirmed" selected="@(Model.FilterStatus == "Confirmed")">Confirmed</option>
                        <option value="Seated" selected="@(Model.FilterStatus == "Seated")">Seated</option>
                        <option value="Completed" selected="@(Model.FilterStatus == "Completed")">Completed</option>
                        <option value="Cancelled" selected="@(Model.FilterStatus == "Cancelled")">Cancelled</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-gold w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                </div>
            </div>
        </form>

        <!-- Data Table -->
        <div class="content-card">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Booking Code</th>
                            <th>Customer Info</th>
                            <th>Date & Time</th>
                            <th>Table</th>
                            <th>Pax</th>
                            <th>Requests</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Reservations.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">No reservations found matching your filters.</td></tr>
                        }
                        @foreach (var res in Model.Reservations)
                        {
                            var badge = res.Status.ToString().ToLower() switch {
                                "pending" => "badge-pending",
                                "confirmed" => "badge-confirmed",
                                "seated" => "badge-seated",
                                "completed" => "badge-completed",
                                "cancelled" => "badge-cancelled",
                                _ => "badge-noshow"
                            };

                            <tr>
                                <td class="fw-bold font-monospace text-primary">@res.ReservationCode</td>
                                <td>
                                    <div class="fw-bold">@res.Customer?.FullName</div>
                                    <div class="small text-muted">@res.Customer?.PhoneNumber</div>
                                </td>
                                <td>
                                    <div class="fw-bold">@res.StartTime.ToString("dd MMM yyyy")</div>
                                    <div class="small text-muted">@res.StartTime.ToString("h:mm tt")</div>
                                </td>
                                <td><span class="badge bg-dark">@res.RestaurantTable?.TableNumber</span></td>
                                <td>@res.PartySize</td>
                                <td class="small text-muted text-truncate" style="max-width: 150px;" title="@res.SpecialRequests">
                                    @(string.IsNullOrEmpty(res.SpecialRequests) ? "-" : res.SpecialRequests)
                                </td>
                                <td><span class="status-badge @badge">@res.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>