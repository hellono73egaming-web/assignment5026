@page
@model WebApplication2.Pages.CustomerPanel.MyReservationsModel
@using WebApplication2.Pages.CustomerPanel
@{
    ViewData["Title"] = "My Reservations";
    Layout = null;

    string[] fallbackImages =
    {
        "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1550966871-3ed3cdb5ed0c?q=80&w=800&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1559339352-11d035aa65de?q=80&w=800&auto=format&fit=crop"
    };

    // Upcoming first (soonest at top), then past (most recent at top)
    var ordered = Model.Reservations.Where(MyReservationsModel.IsUpcoming).OrderBy(r => r.StartTime)
        .Concat(Model.Reservations.Where(r => !MyReservationsModel.IsUpcoming(r)).OrderByDescending(r => r.StartTime))
        .ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Reservations - RROMS</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Header */
        .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin: 40px 0 24px; }
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 0 0 4px; }
        .page-sub { color: var(--muted); margin: 0; }
        .btn-gold { background: var(--accent-gold); color: var(--primary-green); font-weight: 700; border: 0; border-radius: 10px; padding: 10px 22px; text-decoration: none; transition: background-color .2s; }
        .btn-gold:hover { background: var(--gold-dark); color: #fff; }

        /* Filter tabs */
        .filters { display: inline-flex; gap: 4px; padding: 4px; background: #fff; border: 1px solid var(--line); border-radius: 12px; margin-bottom: 24px; }
        .filter-btn { border: 0; background: transparent; padding: 8px 16px; border-radius: 9px; font-weight: 500; font-size: .9rem; color: var(--muted); transition: background-color .2s, color .2s; }
        .filter-btn:hover { color: var(--primary-green); }
        .filter-btn.active { background: var(--primary-green); color: #fff; }
        .filter-btn .count { margin-left: 6px; font-size: .78rem; opacity: .75; }

        /* Reservation card */
        .res-card { display: flex; gap: 20px; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 20px; margin-bottom: 16px; border-left: 5px solid #ccc;}
        .res-date { flex: none; width: 64px; height: 72px; border-radius: 12px; background: rgba(30,63,32,.07); color: var(--primary-green);
            display: flex; flex-direction: column; align-items: center; justify-content: center; line-height: 1.1; }
        .res-date .mo { font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
        .res-date .d { font-family: 'Playfair Display', serif; font-weight: 700; font-size: 1.7rem; }
        
        .res-main { flex: 1; min-width: 0; }
        .res-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
        .res-code { font-size: 1rem; font-weight: 700; margin: 0 0 4px; letter-spacing: .02em; overflow-wrap: anywhere; }
        .res-when { color: var(--muted); font-size: .9rem; }
        .res-when i, .res-note i { color: var(--accent-gold); margin-right: 8px; width: 16px; text-align: center; }
        
        .res-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
        .chip { background: var(--bg-cream); border: 1px solid var(--line); border-radius: 20px; padding: 4px 12px; font-size: .85rem; }
        .chip i { color: var(--gold-dark); margin-right: 6px; }
        .res-note { display: flex; font-size: .9rem; margin: 0; }
        .res-note i { margin-top: 3px; }
        .res-note.none { color: var(--muted); }
        .res-actions { display: flex; gap: 8px; margin-top: 16px; padding-top: 16px; border-top: 1px solid var(--line); }

        /* Image Thumbnail Styling */
        .res-thumb {
            flex: none;
            width: 130px; 
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            background-color: #eee;
        }
        .res-thumb img {
            position: absolute;
            top: 0; left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover; 
        }

        /* Status badges */
        .status-badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; border-radius: 20px; font-size: .8rem; font-weight: 600; white-space: nowrap; }
        .status-badge::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
        .badge-pending   { background: #fdf0d5; color: #8a5a0b; }
        .badge-confirmed { background: #e3f3e7; color: #1d6b34; }
        .badge-seated    { background: #def3f8; color: #0b6679; }
        .badge-completed { background: #e8ebe8; color: #1E3F20; }
        .badge-cancelled { background: #fbeceb; color: #a02e24; }
        .badge-noshow    { background: #eceeef; color: #565d63; }
        
        /* Left accent per status */
        .status-pending { border-left-color: #e3a82b; }
        .status-confirmed { border-left-color: #2e9e5b; }
        .status-seated { border-left-color: #2aa6c0; }
        .status-completed { border-left-color: var(--primary-green); }
        .status-cancelled { border-left-color: #d9534f; }
        .status-noshow { border-left-color: #8d959b; }
        .status-completed .res-date, .status-cancelled .res-date, .status-noshow .res-date { background: #efece4; color: #8a948e; }

        /* Buttons */
        .btn-outline-green { background: transparent; border: 2px solid var(--primary-green); color: var(--primary-green); font-weight: 600; font-size: .875rem; border-radius: 10px; padding: 6px 16px; transition: background-color .2s, color .2s; }
        .btn-outline-green:hover { background: var(--primary-green); color: #fff; }
        .btn-quiet-danger { border: 0; background: transparent; color: #b03a2e; font-weight: 500; font-size: .875rem; border-radius: 10px; padding: 6px 14px; }
        .btn-quiet-danger:hover { background: #fbeceb; color: #962d22; }

        .empty-state { display: none; text-align: center; padding: 48px 16px; background: #fff; border: 1px dashed #d9d4c8; border-radius: 16px; color: var(--muted); }
        .empty-state i { font-size: 2rem; color: #cfc8b8; margin-bottom: 12px; }
        .empty-state.show { display: block; }

        :focus-visible { outline: 3px solid rgba(212,163,115,.6); outline-offset: 2px; }
        
        /* Responsive adjustments */
        @@media (max-width: 575.98px) {
            .res-card { flex-direction: column; gap: 14px; }
            .res-date { width: auto; height: auto; flex-direction: row; gap: 8px; padding: 8px 14px; align-self: flex-start; }
            .res-date .d { font-size: 1.2rem; }
            .filters { display: flex; }
            .filter-btn { flex: 1; padding: 8px 6px; }
            
            .res-thumb { width: 100%; height: 160px; }
        }
        @@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-page="/CustomerPanel/Index"><i class="fa-solid fa-utensils me-2"></i>RROMS</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/CustomerPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/CustomerPanel/Menu">Menu</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/CustomerPanel/BookTable">Book Table</a></li>
                    <li class="nav-item"><a class="nav-link active" aria-current="page" asp-page="/CustomerPanel/MyReservations">My reservations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/CustomerPanel/MyOrders">My Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/CustomerPanel/Feedback">My Reviews</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="page-head">
            <div>
                <h1 class="page-title">My reservations</h1>
                <p class="page-sub">Manage your upcoming bookings and look back at past visits.</p>
            </div>
            <a asp-page="/CustomerPanel/BookTable" class="btn-gold"><i class="fa-solid fa-calendar-plus me-2"></i>Book a table</a>
        </div>

        @if (Model.Message != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                <i class="fa-solid fa-circle-check me-2"></i>@Model.Message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (Model.Error != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i>@Model.Error
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="filters" role="tablist" aria-label="Filter reservations">
            <button type="button" class="filter-btn active" data-filter="all" role="tab" aria-selected="true">All<span class="count"></span></button>
            <button type="button" class="filter-btn" data-filter="upcoming" role="tab" aria-selected="false">Upcoming<span class="count"></span></button>
            <button type="button" class="filter-btn" data-filter="past" role="tab" aria-selected="false">Past<span class="count"></span></button>
        </div>

        <div id="resList">
            @for (var i = 0; i < ordered.Count; i++)
            {
                var res = ordered[i];
                var css = MyReservationsModel.StatusCss(res.Status);
                var group = MyReservationsModel.IsUpcoming(res) ? "upcoming" : "past";
                var img = !string.IsNullOrEmpty(res.RestaurantTable?.DiningArea?.ImageUrl)
                    ? res.RestaurantTable!.DiningArea!.ImageUrl!
                    : fallbackImages[i % fallbackImages.Length];

                <article class="res-card status-@css" data-group="@group">
                    <div class="res-thumb">
                        <img src="@img" alt="Table @res.RestaurantTable?.TableNumber">
                    </div>
                    <div class="res-date" aria-hidden="true"><span class="mo">@res.StartTime.ToString("MMM")</span><span class="d">@res.StartTime.ToString("dd")</span></div>
                    <div class="res-main">
                        <div class="res-top">
                            <div>
                                <h2 class="res-code">@res.ReservationCode</h2>
                                <div class="res-when"><i class="fa-regular fa-clock"></i>@res.StartTime.ToString("MMM dd, yyyy 'at' h:mm tt")</div>
                            </div>
                            <span class="status-badge badge-@css">@MyReservationsModel.StatusLabel(res.Status)</span>
                        </div>
                        <div class="res-chips">
                            <span class="chip"><i class="fa-solid fa-chair"></i>Table @res.RestaurantTable?.TableNumber</span>
                            @if (res.RestaurantTable?.DiningArea != null)
                            {
                                <span class="chip"><i class="fa-solid fa-location-dot"></i>@res.RestaurantTable.DiningArea.Name</span>
                            }
                            <span class="chip"><i class="fa-solid fa-users"></i>@res.PartySize @(res.PartySize == 1 ? "person" : "people")</span>
                        </div>
                        @if (string.IsNullOrWhiteSpace(res.SpecialRequests))
                        {
                            <p class="res-note none"><i class="fa-regular fa-comment-dots"></i><span>No special requests</span></p>
                        }
                        else
                        {
                            <p class="res-note"><i class="fa-regular fa-comment-dots"></i><span>@res.SpecialRequests</span></p>
                        }

                        @if (MyReservationsModel.CanChange(res))
                        {
                            <div class="res-actions">
                                <a asp-page="/CustomerPanel/BookTable" asp-route-editId="@res.Id" class="btn-outline-green text-decoration-none"><i class="fa-solid fa-pen me-1"></i>Modify</a>
                                <button type="button" class="btn-quiet-danger" data-bs-toggle="modal" data-bs-target="#cancelModal"
                                        data-id="@res.Id" data-code="@res.ReservationCode"><i class="fa-solid fa-xmark me-1"></i>Cancel</button>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="empty-state" id="emptyState">
            <i class="fa-regular fa-calendar" aria-hidden="true"></i>
            <p class="mb-3">No reservations here yet.</p>
            <a asp-page="/CustomerPanel/BookTable" class="btn-gold">Book a table</a>
        </div>
    </div>

    <!-- Cancel confirmation -->
    <div class="modal fade" id="cancelModal" tabindex="-1" aria-labelledby="cancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 16px;">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title fs-5" id="cancelModalLabel" style="font-family: 'Playfair Display', serif; color: var(--primary-green);">Cancel this reservation?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-muted">
                    Reservation <strong id="cancelCode"></strong> will be cancelled and the table released.
                </div>
                <form method="post" asp-page-handler="Cancel" class="modal-footer border-0 pt-0">
                    <input type="hidden" name="id" id="cancelId" />
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="border-radius: 10px;">Keep reservation</button>
                    <button type="submit" class="btn btn-danger" style="border-radius: 10px;">Yes, cancel it</button>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const cards = [...document.querySelectorAll('.res-card')];
            const buttons = [...document.querySelectorAll('.filter-btn')];
            const empty = document.getElementById('emptyState');

            // Counts on each tab
            buttons.forEach(b => {
                const f = b.dataset.filter;
                const n = f === 'all' ? cards.length : cards.filter(c => c.dataset.group === f).length;
                b.querySelector('.count').textContent = n;
            });

            function apply(filter) {
                let shown = 0;
                cards.forEach(c => {
                    const show = filter === 'all' || c.dataset.group === filter;
                    c.style.display = show ? '' : 'none';
                    if (show) shown++;
                });
                empty.classList.toggle('show', shown === 0);
                buttons.forEach(b => {
                    const on = b.dataset.filter === filter;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-selected', on);
                });
            }
            buttons.forEach(b => b.addEventListener('click', () => apply(b.dataset.filter)));
            apply('all');

            // Put the reservation code and id in the cancel dialog
            document.getElementById('cancelModal').addEventListener('show.bs.modal', e => {
                document.getElementById('cancelCode').textContent = e.relatedTarget.dataset.code;
                document.getElementById('cancelId').value = e.relatedTarget.dataset.id;
            });
        })();
    </script>
</body>
</html>
