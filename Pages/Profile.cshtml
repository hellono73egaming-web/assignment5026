@page
@model ProfileModel
@{
    ViewData["Title"] = "My Profile";
    Layout = null; // page has its own navbar and Bootstrap, like Login/Register

    // Initials for the avatar (first letter of up to two words)
    var nameParts = (Model.Input.FullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length switch
    {
        0 => "?",
        1 => nameParts[0].Substring(0, 1).ToUpper(),
        _ => (nameParts[0].Substring(0, 1) + nameParts[^1].Substring(0, 1)).ToUpper()
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Profile - RROMS</title>
<!-- Bootstrap 5 & FontAwesome -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

<style>
    :root {
        --primary-green: #1E3F20;
        --green-soft: #2a5530;
        --accent-gold: #D4A373;
        --gold-dark: #b98550;
        --bg-cream: #F9F6F0;
        --text-dark: #2C3E50;
        --line: #e8e3d9;
    }

    body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

    /* Navbar */
    .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
    .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
    .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
    .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

    /* Page heading */
    .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin-bottom: .25rem; }
    .page-sub { color: #6b7a72; margin-bottom: 2rem; }

    /* Cards */
    .profile-card { border: 1px solid var(--line); border-radius: 16px; background: #fff; overflow: hidden; box-shadow: 0 1px 2px rgba(30,63,32,.04); }

    /* Summary card */
    .profile-summary { background: var(--primary-green); color: #fff; padding: 36px 24px 30px; text-align: center; }
    .avatar-circle {
        width: 104px; height: 104px; margin: 0 auto 18px; border-radius: 50%;
        background: var(--accent-gold); color: var(--primary-green);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Playfair Display', serif; font-weight: 700; font-size: 2.4rem;
        box-shadow: 0 0 0 6px rgba(212,163,115,.25);
    }
    .profile-summary h4 { font-family: 'Playfair Display', serif; font-size: 1.4rem; overflow-wrap: anywhere; }
    .profile-summary .email { color: rgba(255,255,255,.7); font-size: .9rem; overflow-wrap: anywhere; }
    .role-badge { background: rgba(212,163,115,.18); color: var(--accent-gold); border: 1px solid rgba(212,163,115,.5);
        padding: 4px 14px; border-radius: 20px; font-weight: 600; font-size: .85rem; display: inline-block; margin-top: 12px; }

    .detail-list { margin: 0; padding: 8px 24px 12px; }
    .detail-list div { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .detail-list div:last-child { border-bottom: 0; }
    .detail-list dt { font-weight: 400; color: #6b7a72; font-size: .88rem; }
    .detail-list dd { margin: 0; font-weight: 600; font-size: .9rem; text-align: right; overflow-wrap: anywhere; }
    .status-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #2e9e5b; margin-right: 6px; }

    /* Form */
    .form-section + .form-section { margin-top: 2.25rem; padding-top: 2rem; border-top: 1px solid var(--line); }
    .section-title { font-family: 'Playfair Display', serif; color: var(--primary-green); font-weight: 700; font-size: 1.25rem; margin-bottom: .25rem; }
    .section-hint { color: #6b7a72; font-size: .9rem; margin-bottom: 1.25rem; }

    .form-label { font-weight: 600; font-size: .9rem; }
    .form-control { border-radius: 10px; padding: 12px 15px; border: 1px solid #d9d4c8; background: #fff; }
    .form-control:focus { border-color: var(--accent-gold); box-shadow: 0 0 0 .25rem rgba(212,163,115,.25); }
    .form-control[readonly] { background: #f1eee7; color: #6b7a72; cursor: not-allowed; }
    .input-icon { position: relative; }
    .input-icon .form-control { padding-right: 46px; }
    .toggle-pw { position: absolute; top: 0; right: 0; height: 100%; width: 46px; border: 0; background: none; color: #8a948e; border-radius: 0 10px 10px 0; }
    .toggle-pw:hover { color: var(--primary-green); }

    /* Password strength */
    .strength { height: 6px; border-radius: 3px; background: var(--line); margin-top: 10px; overflow: hidden; }
    .strength-bar { height: 100%; width: 0; border-radius: 3px; transition: width .25s, background-color .25s; }
    .strength-text { font-size: .8rem; color: #6b7a72; margin-top: 6px; min-height: 1.2em; }

    /* Buttons */
    .btn-gold { background: var(--accent-gold); color: var(--primary-green); font-weight: 700; border-radius: 10px; padding: 12px 28px; border: 0; transition: background-color .2s; }
    .btn-gold:hover:not(:disabled) { background: var(--gold-dark); color: #fff; }
    .btn-gold:disabled { opacity: .45; cursor: not-allowed; }
    .btn-ghost { background: transparent; border: 1px solid #d9d4c8; border-radius: 10px; padding: 12px 24px; color: var(--text-dark); font-weight: 500; }
    .btn-ghost:hover { background: #f1eee7; }

    .form-footer { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
    .unsaved { color: #8a6a3d; font-size: .88rem; visibility: hidden; }
    .unsaved.show { visibility: visible; }

    :focus-visible { outline: 3px solid rgba(212,163,115,.6); outline-offset: 2px; }
    @@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
</head>
<body>

<!-- Dashboard Navbar -->
<nav class="navbar navbar-expand-lg navbar-custom mb-5">
    <div class="container">
        <a class="navbar-brand" asp-page="@Model.DashboardPage"><i class="fa-solid fa-utensils me-2"></i>RROMS</a>
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
            <i class="fa-solid fa-bars text-white"></i>
        </button>
        <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
            <ul class="navbar-nav align-items-lg-center">
                <!-- Change these links based on Role in your actual code -->
                <li class="nav-item"><a class="nav-link" asp-page="@Model.DashboardPage">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link active" aria-current="page" asp-page="/Profile">My profile</a></li>
                <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                    <!-- Logout must be a POST (protected by the anti-forgery token) -->
                    <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                        <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<div class="container pb-5">
    <h1 class="page-title">My profile</h1>
    <p class="page-sub">Update your contact details and password.</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div id="successAlert" class="alert alert-success alert-dismissible fade show shadow-sm" role="status">
            <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">

        <!-- LEFT: Summary -->
        <div class="col-lg-4">
            <div class="profile-card">
                <div class="profile-summary">
                    <div class="avatar-circle" aria-hidden="true">@initials</div>
                    <h4 class="mb-1">@Model.Input.FullName</h4>
                    <div class="email">@Model.Input.Email</div>
                    <span class="role-badge">@Model.UserRole</span>
                </div>
                <dl class="detail-list">
                    <div><dt>Phone</dt><dd>@Model.Input.PhoneNumber</dd></div>
                    <div><dt>Member since</dt><dd>@Model.MemberSince.ToString("MMM yyyy")</dd></div>
                    <div><dt>Account status</dt><dd><span class="status-dot"></span>Active</dd></div>
                </dl>
            </div>
        </div>

        <!-- RIGHT: Edit form -->
        <div class="col-lg-8">
            <div class="profile-card p-4 p-md-5">
                <form method="post" id="profileForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small" role="alert"></div>

                    <section class="form-section">
                        <h2 class="section-title">Personal details</h2>
                        <p class="section-hint">This is how you appear to the restaurant team.</p>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Input.FullName" class="form-label"></label>
                                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                                <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                                <input asp-for="Input.PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Input.Email" class="form-label"></label>
                                <input asp-for="Input.Email" class="form-control" readonly aria-describedby="emailHelp" />
                                <div id="emailHelp" class="form-text">Your email can’t be changed.</div>
                            </div>
                        </div>
                    </section>

                    <section class="form-section">
                        <h2 class="section-title">Password</h2>
                        <p class="section-hint">
                            @(Model.HasPassword
                                ? "Leave the password fields empty to keep your current password."
                                : "You signed up with Google, Facebook or Microsoft. Set a password to also log in with email.")
                        </p>

                        <div class="row g-3">
                            @if (Model.HasPassword)
                            {
                                <div class="col-md-6">
                                    <label asp-for="Input.CurrentPassword" class="form-label"></label>
                                    <div class="input-icon">
                                        <input asp-for="Input.CurrentPassword" class="form-control" id="currentPassword" autocomplete="current-password" />
                                        <button type="button" class="toggle-pw" data-target="currentPassword" aria-label="Show password">
                                            <i class="fa-regular fa-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Input.CurrentPassword" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6 d-none d-md-block"></div>
                            }
                            <div class="col-md-6">
                                <label asp-for="Input.NewPassword" class="form-label"></label>
                                <div class="input-icon">
                                    <input asp-for="Input.NewPassword" class="form-control" id="newPassword" autocomplete="new-password" />
                                    <button type="button" class="toggle-pw" data-target="newPassword" aria-label="Show password">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <div class="strength" aria-hidden="true"><div class="strength-bar" id="strengthBar"></div></div>
                                <div class="strength-text" id="strengthText" aria-live="polite"></div>
                                <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Input.ConfirmNewPassword" class="form-label"></label>
                                <div class="input-icon">
                                    <input asp-for="Input.ConfirmNewPassword" class="form-control" id="confirmNewPassword" autocomplete="new-password" />
                                    <button type="button" class="toggle-pw" data-target="confirmNewPassword" aria-label="Show password">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <div class="strength-text" id="matchText" aria-live="polite"></div>
                                <span asp-validation-for="Input.ConfirmNewPassword" class="text-danger small"></span>
                            </div>
                        </div>
                    </section>

                    <div class="form-footer">
                        <span class="unsaved" id="unsaved"><i class="fa-solid fa-circle-exclamation me-1"></i>You have unsaved changes</span>
                        <div class="d-flex gap-2">
                            <button type="reset" class="btn-ghost" id="cancelBtn">Discard changes</button>
                            <button type="submit" class="btn-gold" id="saveBtn" disabled>Save changes</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
        (function () {
            const form = document.getElementById('profileForm');
            const saveBtn = document.getElementById('saveBtn');
            const unsaved = document.getElementById('unsaved');
            const pw = document.getElementById('newPassword');
            const confirmPw = document.getElementById('confirmNewPassword');
            const bar = document.getElementById('strengthBar');
            const strengthText = document.getElementById('strengthText');
            const matchText = document.getElementById('matchText');

            // Only these fields count as "editable" for the unsaved-changes check
            const fields = [...form.querySelectorAll('input:not([readonly]):not([type=hidden])')];
            const snapshot = () => fields.map(f => f.value).join('\u0001');
            let initial = snapshot();

            function refreshDirty() {
                const dirty = snapshot() !== initial;
                saveBtn.disabled = !dirty;
                unsaved.classList.toggle('show', dirty);
            }

            function refreshStrength() {
                const v = pw.value;
                if (!v) { bar.style.width = '0'; strengthText.textContent = ''; return; }
                let score = 0;
                if (v.length >= 8) score++;
                if (v.length >= 12) score++;
                if (/[a-z]/.test(v) && /[A-Z]/.test(v)) score++;
                if (/\d/.test(v)) score++;
                if (/[^A-Za-z0-9]/.test(v)) score++;
                const levels = [
                    ['20%', '#c0392b', 'Too weak'],
                    ['20%', '#c0392b', 'Too weak'],
                    ['40%', '#e08a2e', 'Weak'],
                    ['60%', '#d4a373', 'Okay'],
                    ['80%', '#5f9e5b', 'Strong'],
                    ['100%', '#2e7d32', 'Very strong']
                ];
                const [w, c, t] = levels[score];
                bar.style.width = w; bar.style.backgroundColor = c; strengthText.textContent = t;
            }

            function refreshMatch() {
                if (!confirmPw.value) { matchText.textContent = ''; return; }
                const ok = pw.value === confirmPw.value;
                matchText.textContent = ok ? 'Passwords match' : 'Passwords don’t match yet';
                matchText.style.color = ok ? '#2e7d32' : '#c0392b';
            }

            form.addEventListener('input', () => { refreshDirty(); refreshStrength(); refreshMatch(); });
            form.addEventListener('reset', () => setTimeout(() => { refreshDirty(); refreshStrength(); refreshMatch(); }, 0));

            // Show / hide password
            document.querySelectorAll('.toggle-pw').forEach(btn => {
                btn.addEventListener('click', () => {
                    const input = document.getElementById(btn.dataset.target);
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    btn.firstElementChild.className = show ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                });
            });

            // Auto-dismiss the success message
            const ok = document.getElementById('successAlert');
            if (ok) setTimeout(() => bootstrap.Alert.getOrCreateInstance(ok).close(), 5000);

            // Warn before leaving with unsaved edits (not when submitting)
            let submitting = false;
            form.addEventListener('submit', () => { submitting = true; });
            window.addEventListener('beforeunload', e => {
                if (!submitting && snapshot() !== initial) { e.preventDefault(); e.returnValue = ''; }
            });
        })();
    </script>
</body>
</html>
