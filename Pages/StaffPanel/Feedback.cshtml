@page
@model WebApplication2.Pages.StaffPanel.FeedbackModel
@using WebApplication2.Pages.StaffPanel
@{
    ViewData["Title"] = "Recent Feedback";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recent Feedback - Artie's Staff</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Page Header */
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 40px 0 10px; }
        .page-sub { color: var(--muted); margin-bottom: 30px; }

        /* Top Stat Card */
        .stat-card { background: #fff; border-radius: 16px; border: 1px solid var(--line); padding: 25px; box-shadow: 0 5px 20px rgba(0,0,0,0.03); display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
        .stat-icon { width: 60px; height: 60px; border-radius: 50%; background: rgba(212, 163, 115, 0.15); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        
        /* Review Items */
        .content-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 30px; box-shadow: 0 4px 12px rgba(0,0,0,.02); }
        .review-item { border-bottom: 1px solid var(--line); padding-bottom: 25px; margin-bottom: 25px; }
        .review-item:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
        
        .review-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
        .customer-info { display: flex; align-items: center; gap: 15px; }
        .avatar-circle { width: 45px; height: 45px; background-color: rgba(30, 63, 32, 0.08); color: var(--primary-green); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; }
        .customer-name { font-weight: 700; color: var(--text-dark); margin: 0; font-size: 1rem; }
        .review-date { font-size: 0.8rem; color: var(--muted); }
        
        .stars { color: #ffc107; font-size: 0.95rem; margin-bottom: 5px; }
        .review-comment { font-size: 0.95rem; color: #444; background: #fbfbfb; padding: 15px 20px; border-radius: 8px; border-left: 3px solid var(--accent-gold); margin-top: 10px; line-height: 1.5; }
        
        .order-ref { font-size: 0.75rem; color: var(--muted); display: block; margin-top: 5px; }
        .table-badge { background: #2C3E50; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; margin-left: 5px; }

        /* Manager Reply (Read-only for staff) */
        .manager-reply { margin-top: 15px; margin-left: 40px; background: rgba(30, 63, 32, 0.03); padding: 12px 15px; border-radius: 8px; border-left: 3px solid var(--primary-green); }
        .manager-reply-text { font-size: 0.85rem; color: #555; margin: 0; font-style: italic; }
    </style>
</head>
<body>

    <!-- Staff Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-page="/StaffPanel/Index"><i class="fa-solid fa-utensils me-2"></i>Artie's Staff</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Reservations">Today's Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/ActiveOrders">Active Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Billing">Billing</a></li>
                    <li class="nav-item"><a class="nav-link active fw-bold" asp-page="/StaffPanel/Feedback">Feedback</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My Profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <h1 class="page-title">Recent Feedback</h1>
        <p class="page-sub">See what our customers are saying about their dining experience.</p>

        <!-- Today's Snapshot -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="stat-card">
                    <div>
                        <div class="text-muted fw-bold small text-uppercase mb-1">Today's Reviews</div>
                        <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@Model.TodayCount <span class="fs-6 text-muted fw-normal">new @(Model.TodayCount == 1 ? "review" : "reviews")</span></h2>
                    </div>
                    <div class="stat-icon"><i class="fa-regular fa-comment-dots"></i></div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="stat-card">
                    <div>
                        <div class="text-muted fw-bold small text-uppercase mb-1">Today's Average Rating</div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@(Model.TodayCount == 0 ? "-" : Model.TodayAverage.ToString("0.0"))</h2>
                            <div class="stars mb-0">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var icon = Model.TodayAverage >= i ? "fa-solid fa-star" : Model.TodayAverage >= i - 0.5 ? "fa-solid fa-star-half-stroke" : "fa-regular fa-star";
                                    <i class="@icon"></i>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
                </div>
            </div>
        </div>

        <!-- Recent Reviews List -->
        <div class="content-card">
            @if (!Model.Recent.Any())
            {
                <p class="text-muted text-center mb-0">No reviews yet.</p>
            }

            @foreach (var r in Model.Recent)
            {
                <div class="review-item">
                    <div class="review-header">
                        <div class="customer-info">
                            <div class="avatar-circle">@FeedbackModel.Initial(r.Customer?.FullName)</div>
                            <div>
                                <p class="customer-name">@r.Customer?.FullName</p>
                                <span class="review-date"><i class="fa-regular fa-clock me-1"></i> @FeedbackModel.When(r.CreatedAt)</span>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="stars" aria-label="@r.Rating out of 5 stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="@(i <= r.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                                }
                            </div>
                            @if (r.Reservation != null)
                            {
                                <span class="order-ref">@FeedbackModel.Service(r.Reservation.StartTime) <span class="table-badge">Table @r.Reservation.RestaurantTable?.TableNumber</span></span>
                            }
                        </div>
                    </div>
                    <div class="review-comment">
                        "@(r.Comment ?? "No comment provided.")"
                    </div>
                    @if (r.AdminReply != null)
                    {
                        <div class="manager-reply">
                            <p class="manager-reply-text"><strong>Manager Reply:</strong> @r.AdminReply</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
