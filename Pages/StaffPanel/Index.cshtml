@page
@model WebApplication2.Pages.StaffPanel.IndexModel
@using WebApplication2.Models
@using WebApplication2.Services
@using WebApplication2.Pages.StaffPanel
@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = null;
    var s = Model.Data.Stats;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard - Artie's Staff</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-green: #1E3F20; --accent-gold: #D4A373; --gold-dark: #b98550;
            --bg-cream: #F9F6F0; --text-dark: #2C3E50; --muted: #6b7a72; --line: #e8e3d9;
        }
        body { font-family: 'Inter', sans-serif; background-color: var(--bg-cream); color: var(--text-dark); }

        /* Navbar */
        .navbar-custom { background-color: var(--primary-green); padding: 15px 0; box-shadow: 0 4px 12px rgba(0,0,0,.1); }
        .navbar-custom .navbar-brand { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--bg-cream); font-size: 1.5rem; }
        .navbar-custom .nav-link { color: #d1d8d2; font-weight: 500; transition: color .2s; }
        .navbar-custom .nav-link:hover, .navbar-custom .nav-link.active { color: var(--accent-gold); }

        /* Page Header */
        .page-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 2rem; margin: 40px 0 10px; }
        .page-sub { color: var(--muted); margin-bottom: 30px; }

        /* Top Stat Card */
        .stat-card { background: #fff; border-radius: 16px; border: 1px solid var(--line); padding: 25px; box-shadow: 0 5px 20px rgba(0,0,0,0.03); display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
        .stat-icon { width: 60px; height: 60px; border-radius: 50%; background: rgba(212, 163, 115, 0.15); color: var(--accent-gold); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; }
        
        /* Review Items */
        .content-card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 30px; box-shadow: 0 4px 12px rgba(0,0,0,.02); }
        .review-item { border-bottom: 1px solid var(--line); padding-bottom: 25px; margin-bottom: 25px; }
        .review-item:last-child { border-bottom: none; padding-bottom: 0; margin-bottom: 0; }
        
        .review-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
        .customer-info { display: flex; align-items: center; gap: 15px; }
        .avatar-circle { width: 45px; height: 45px; background-color: rgba(30, 63, 32, 0.08); color: var(--primary-green); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.1rem; }
        .customer-name { font-weight: 700; color: var(--text-dark); margin: 0; font-size: 1rem; }
        .review-date { font-size: 0.8rem; color: var(--muted); }
        
        .stars { color: #ffc107; font-size: 0.95rem; margin-bottom: 5px; }
        .review-comment { font-size: 0.95rem; color: #444; background: #fbfbfb; padding: 15px 20px; border-radius: 8px; border-left: 3px solid var(--accent-gold); margin-top: 10px; line-height: 1.5; }
        
        .order-ref { font-size: 0.75rem; color: var(--muted); display: block; margin-top: 5px; }
        .table-badge { background: #2C3E50; color: white; padding: 3px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 700; margin-left: 5px; }

        /* Manager Reply (Read-only for staff) */
        .manager-reply { margin-top: 15px; margin-left: 40px; background: rgba(30, 63, 32, 0.03); padding: 12px 15px; border-radius: 8px; border-left: 3px solid var(--primary-green); }
        .manager-reply-text { font-size: 0.85rem; color: #555; margin: 0; font-style: italic; }
            /* Dashboard */
        .stat-card { cursor: default; }
        .stat-card h2 { font-size: 2rem; }
        .stat-icon.green { background: rgba(30,63,32,.08); color: var(--primary-green); }
        .stat-icon.blue { background: rgba(11,102,121,.1); color: #0b6679; }
        .stat-icon.red { background: rgba(160,46,36,.1); color: #a02e24; }
        .panel-title { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--primary-green); font-size: 1.25rem; margin: 0; }
        .row-item { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--line); }
        .row-item:last-child { border-bottom: 0; }
        .row-time { font-weight: 700; color: var(--primary-green); min-width: 78px; }
        .row-sub { font-size: .82rem; color: var(--muted); }
        .status-badge { padding: 5px 11px; border-radius: 20px; font-size: .72rem; font-weight: 600; text-transform: uppercase; white-space: nowrap; }
        .badge-pending { background: #fdf0d5; color: #8a5a0b; }
        .badge-confirmed { background: #e3f3e7; color: #1d6b34; }
        .badge-seated { background: #def3f8; color: #0b6679; }
        .badge-muted { background: #eceeef; color: #565d63; }
        .quick-btn { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border: 1px solid var(--line); border-radius: 12px; background: #fff;
                     color: var(--text-dark); text-decoration: none; font-weight: 600; transition: .2s; height: 100%; }
        .quick-btn i { width: 40px; height: 40px; border-radius: 10px; background: rgba(212,163,115,.15); color: var(--gold-dark);
                       display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .quick-btn:hover { border-color: var(--accent-gold); box-shadow: 0 6px 16px rgba(212,163,115,.18); color: var(--text-dark); transform: translateY(-2px); }
        .link-more { font-size: .85rem; font-weight: 600; color: var(--primary-green); text-decoration: none; }
    </style>
</head>
<body>

    <!-- Staff Navbar -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-page="/StaffPanel/Index"><i class="fa-solid fa-utensils me-2"></i>Artie's Staff</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav align-items-lg-center">
                    <li class="nav-item"><a class="nav-link active fw-bold" asp-page="/StaffPanel/Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Reservations">Today's Reservations</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/ActiveOrders">Active Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Billing">Billing</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/StaffPanel/Feedback">Feedback</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Profile">My Profile</a></li>
                    <li class="nav-item ms-lg-3 mt-2 mt-lg-0">
                        <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm px-3">Log out</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container pb-5">
        <div class="d-flex justify-content-between align-items-end flex-wrap gap-2">
            <div>
                <h1 class="page-title">Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 17 ? "afternoon" : "evening"), @Model.StaffName</h1>
                <p class="page-sub">@Model.Position &middot; @DateTime.Today.ToString("dddd, d MMMM yyyy") &middot; refreshes every 60s</p>
            </div>
        </div>

        <!-- Today's numbers -->
        <div class="row g-4 mb-2">
            <div class="col-md-6 col-xl-3">
                <a asp-page="/StaffPanel/Reservations" class="text-decoration-none">
                    <div class="stat-card">
                        <div>
                            <div class="text-muted fw-bold small text-uppercase mb-1">Reservations Today</div>
                            <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@s.TodayReservations</h2>
                        </div>
                        <div class="stat-icon green"><i class="fa-solid fa-calendar-day"></i></div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-3">
                <a asp-page="/StaffPanel/Reservations" class="text-decoration-none">
                    <div class="stat-card">
                        <div>
                            <div class="text-muted fw-bold small text-uppercase mb-1">Awaiting Confirmation</div>
                            <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@s.PendingReservations</h2>
                        </div>
                        <div class="stat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-3">
                <a asp-page="/StaffPanel/ActiveOrders" class="text-decoration-none">
                    <div class="stat-card">
                        <div>
                            <div class="text-muted fw-bold small text-uppercase mb-1">New / Preparing Orders</div>
                            <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@s.PendingOrders <span class="fs-6 text-muted fw-normal">new</span> &middot; @s.PreparingOrders <span class="fs-6 text-muted fw-normal">cooking</span></h2>
                        </div>
                        <div class="stat-icon blue"><i class="fa-solid fa-fire-burner"></i></div>
                    </div>
                </a>
            </div>
            <div class="col-md-6 col-xl-3">
                <a asp-page="/StaffPanel/Billing" class="text-decoration-none">
                    <div class="stat-card">
                        <div>
                            <div class="text-muted fw-bold small text-uppercase mb-1">Unpaid Bills</div>
                            <h2 class="fw-bold mb-0" style="color: var(--primary-green);">@Model.Data.UnpaidBills <span class="fs-6 text-muted fw-normal">RM @Model.Data.UnpaidTotal.ToString("N2")</span></h2>
                        </div>
                        <div class="stat-icon red"><i class="fa-solid fa-cash-register"></i></div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Quick links -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3"><a asp-page="/StaffPanel/Reservations" class="quick-btn"><i class="fa-solid fa-calendar-check"></i>Today's Reservations</a></div>
            <div class="col-6 col-lg-3"><a asp-page="/StaffPanel/ActiveOrders" class="quick-btn"><i class="fa-solid fa-utensils"></i>Kitchen Board</a></div>
            <div class="col-6 col-lg-3"><a asp-page="/StaffPanel/Billing" class="quick-btn"><i class="fa-solid fa-receipt"></i>Billing</a></div>
            <div class="col-6 col-lg-3"><a asp-page="/StaffPanel/Feedback" class="quick-btn"><i class="fa-regular fa-comment-dots"></i>Customer Feedback</a></div>
        </div>

        <div class="row g-4">
            <!-- Next reservations -->
            <div class="col-lg-6">
                <div class="content-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="panel-title"><i class="fa-solid fa-calendar-day me-2" style="color: var(--accent-gold);"></i>Next Up Today</h2>
                        <a asp-page="/StaffPanel/Reservations" class="link-more">View all</a>
                    </div>
                    @if (!Model.Data.NextReservations.Any())
                    {
                        <p class="text-muted mb-0 mt-3">No more bookings to handle today.</p>
                    }
                    @foreach (var r in Model.Data.NextReservations)
                    {
                        <div class="row-item">
                            <div class="row-time">@r.StartTime.ToString("h:mm tt")</div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@r.Customer?.FullName</div>
                                <div class="row-sub">Table @r.RestaurantTable?.TableNumber &middot; @(r.PartySize + " pax" + (string.IsNullOrWhiteSpace(r.SpecialRequests) ? "" : " · " + r.SpecialRequests))</div>
                            </div>
                            <span class="status-badge @IndexModel.ReservationCss(r.Status)">@r.Status</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Orders needing action -->
            <div class="col-lg-6">
                <div class="content-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h2 class="panel-title"><i class="fa-solid fa-bell-concierge me-2" style="color: var(--accent-gold);"></i>Orders Needing Action</h2>
                        <a asp-page="/StaffPanel/ActiveOrders" class="link-more">Kitchen board</a>
                    </div>
                    @if (!Model.Data.OrdersNeedingAction.Any())
                    {
                        <p class="text-muted mb-0 mt-3">All caught up. No new or ready orders.</p>
                    }
                    @foreach (var o in Model.Data.OrdersNeedingAction)
                    {
                        <div class="row-item">
                            <div class="row-time">#@o.OrderNumber</div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@o.Customer?.FullName <span class="row-sub">&middot; @IndexModel.TableOf(o)</span></div>
                                <div class="row-sub">@string.Join(", ", o.OrderItems.Select(i => $"{i.Quantity}x {i.MenuItem?.Name}"))</div>
                            </div>
                            <span class="status-badge @IndexModel.OrderCss(o.Status)">@(o.Status == OrderStatus.ReadyToServe ? "Ready to serve" : "New")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Keep the numbers fresh during service
        setTimeout(() => location.reload(), 60000);
    </script>
</body>
</html>
