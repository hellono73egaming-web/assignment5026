@page
@model WebApplication2.Pages.StaffPanel.IndexModel
@{
    ViewData["Title"] = "Staff Dashboard";
}

<h2 class="mb-1">Staff Dashboard</h2>
<p class="text-muted mb-4">Hello @Model.StaffName (@Model.Position).</p>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm"><div class="card-body">
            <div class="text-muted small">Reservations today</div>
            <div class="fs-3 fw-bold">@Model.TodayReservations</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm"><div class="card-body">
            <div class="text-muted small">Awaiting confirmation</div>
            <div class="fs-3 fw-bold">@Model.PendingReservations</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm"><div class="card-body">
            <div class="text-muted small">New orders</div>
            <div class="fs-3 fw-bold">@Model.PendingOrders</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm"><div class="card-body">
            <div class="text-muted small">Preparing</div>
            <div class="fs-3 fw-bold">@Model.PreparingOrders</div>
        </div></div>
    </div>
</div>

<p class="text-muted">Reservation and order management pages will be linked here.</p>
